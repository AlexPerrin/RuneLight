+	/**
+	 * Logs in through the client's own login: while on the login screen it presses the page's submit (setGameState
+	 * LOGGING_IN: desktop submits the credentials, the mobile presses Sign in, Accept, Play Now or Try again), again
+	 * on each read the client is still there, until it is LOGGED_IN or back on the login screen after LOGGING_IN
+	 * (refused). Returns the gameState and loginIndex it ends on.
+	 */
+	private JsonElement login(JsonObject args) throws Exception
+	{
+		String username = args.has("username") ? args.get("username").getAsString() : null;
+		String password = args.has("password") ? args.get("password").getAsString() : null;
+		boolean[] loggingIn = {false};
+		while (true)
+		{
+			JsonObject r = onClientThread(() ->
+			{
+				GameState gs = client.getGameState();
+				if (gs == GameState.LOGIN_SCREEN && !loggingIn[0])
+				{
+					if (username != null)
+					{
+						client.setUsername(username);
+					}
+					if (password != null)
+					{
+						client.setPassword(password);
+					}
+					client.setGameState(GameState.LOGGING_IN);
+					gs = client.getGameState();
+				}
+				loggingIn[0] |= gs == GameState.LOGGING_IN;
+				JsonObject o = new JsonObject();
+				o.addProperty("gameState", gs.name());
+				o.addProperty("loginIndex", client.getLoginIndex());
+				return o;
+			});
+			String gs = r.get("gameState").getAsString();
+			if (gs.equals(GameState.LOGGED_IN.name()) || (loggingIn[0] && gs.equals(GameState.LOGIN_SCREEN.name())))
+			{
+				return r;
+			}
+			Thread.sleep(100);  // the next read of the client's login state
+		}
+	}
+
