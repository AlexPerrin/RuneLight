+	/** Submits the login screen's credentials as the client's own login does, and waits on the outcome it reports. */
+	private JsonElement login(JsonObject args) throws Exception
+	{
+		String username = args.get("username").getAsString();
+		String password = args.get("password").getAsString();
+		GameState submitted = onClientThread(() ->
+		{
+			if (client.getGameState() != GameState.LOGIN_SCREEN)
+			{
+				throw new IllegalStateException("Not on the login screen: gameState " + client.getGameState().name());
+			}
+			client.setUsername(username);
+			client.setPassword(password);
+			client.setGameState(GameState.LOGGING_IN);
+			return client.getGameState();
+		});
+		if (submitted == GameState.LOGIN_SCREEN)
+		{
+			throw new IllegalStateException("The client did not take the submit: gameState LOGIN_SCREEN, loginIndex " + onClientThread(client::getLoginIndex));
+		}
+		// The login connection always ends in a state the client reports (logged in or back on the login screen)
+		JsonObject result;
+		do
+		{
+			Thread.sleep(100);
+			result = onClientThread(() ->
+			{
+				JsonObject r = new JsonObject();
+				r.addProperty("gameState", client.getGameState().name());
+				r.addProperty("loginIndex", client.getLoginIndex());
+				return r;
+			});
+		}
+		while (result.get("gameState").getAsString().equals(GameState.LOGGING_IN.name()));
+		return result;
+	}
